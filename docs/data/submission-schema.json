{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "预制菜名单投稿",
  "type": "object",
  "required": ["name", "projectImage", "evidenceImage"],
  "properties": {
    "name": {
      "type": "string",
      "title": "名称"
    },
    "projectImage": {
      "type": "string",
      "title": "金海豚项目图片"
    },
    "evidenceImage": {
      "type": "string",
      "title": "证据图片"
    },
    "note": {
      "type": "string",
      "title": "备注"
    },
    "linkUrl": {
      "type": "string",
      "format": "uri",
      "title": "跳转链接"
    },
    "developer": {
      "type": "string",
      "title": "开发者（曾用名）"
    },
    "submittedAt": {
      "type": "string",
      "format": "date-time",
      "title": "提交时间"
    }
  }
}
